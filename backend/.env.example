# Application Configuration
PROJECT_NAME="Barber Shop Appointment & Visit Management System"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://tripwallet:tripwallet_password@localhost:5432/barber_booking"

# Security & JWT Authentication
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Business Rules Configuration
CANCELLATION_MINUTES_BEFORE=60
NO_SHOW_GRACE_PERIOD_MINUTES=10
